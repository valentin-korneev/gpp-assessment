flowchart TB
    subgraph MAIN_CENTER["Основной центр - historical 2015"]
        MAIN["Основной сайт"]:::historical
        ALT["Альтернативный сайт"]:::historical
        SHARED[("Общий disk array")]:::historical
        MAIN --> SHARED
        ALT --> SHARED
        MAIN -. "автоматический cluster failover при локальном отказе" .-> ALT
    end

    subgraph BACKUP_CENTER["Резервный центр - historical 2015"]
        DR["Резервный сайт"]:::historical
        DRDISK[("Отдельный disk array")]:::historical
        DR --> DRDISK
    end

    MAIN -->|"Oracle replication"| DR
    ALT -. "если Main + Alternative не восстановлены в течение 1 часа: переход в one-site mode" .-> DR
    DR -. "failback после синхронизации; возврат traffic и replication" .-> MAIN

    CUR["Current DR topology / RTO / RPO не подтверждены\nQ-DR-001"]:::unknown
    DR -. "historical evidence не переносится автоматически" .-> CUR

    LEG["Источник: SRC-OPS-001, 13.08.2015\nFACT-GPP-026; currentness = historical"]:::legend

    classDef historical stroke-dasharray:6 4;
    classDef unknown stroke-dasharray:1 4;
    classDef legend stroke-dasharray:2 2;

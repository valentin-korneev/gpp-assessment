flowchart TB
    A["Администратор Центрального банка"] --> PDEF["Определение процесса\nимя / тип / команда / параметры"]
    PDEF --> TPL["Шаблон\nвыбранные процессы + переопределение параметров"]
    TPL --> DAY["Операционный день\nимя + выбранный шаблон"]
    DAY --> RUNS["Процессы операционного дня"]
    RUNS --> RUNNING["İcradadır\nвремя начала + исполнитель"]
    RUNNING --> DONE["Tamamlanıb\nвремя окончания"]
    DONE --> ALL{"Все процессы завершены?"}
    ALL -->|"нет"| RUNS
    ALL -->|"да"| ARCH["Архивировать"]
    ARCH --> HIST["Архивный день и подробности процессов\nXML-артефакт"]

    DAY --> CLOSE["Закрыть / Bağlanmış"]

    A --> MON["Мониторинг"]
    MON --> X1["Файлы XÖHKS"]
    MON --> X2["Успешные платежи XÖHKS"]
    MON --> X3["Платежи между предыдущим и текущим днями"]
    MON --> X4["Неотправленные файлы"]
    MON --> X5["MT-файлы"]

    TECH["Технический слой: REST API + BDA/BDA_ARCHIVE\nсм. bda-cross-layer-trace.mmd"]:::note
    DAY -.-> TECH
    MON -.-> TECH

    classDef note stroke-dasharray:3 3;

    %% Историческая физическая модель CF из SRC-DB-001, версия 003 (09.06.2015).
    %% Сплошные связи - явный FK или прямо документированная смысловая ссылка; пунктирные - INFERENCE logical FK. Nullability и реальные constraints для logical FK не подтверждаются.
    %% Внешние таблицы ORGANIZATION, BGUSER и PAYMENT_METHOD только упомянуты как targets; их schema не разворачивается.

    ORGANIZATION_TYPE {
        INTEGER ID PK
        VARCHAR2_32 NAME "тип: VARCHAR2(32)"
    }

    SC_CATEGORY {
        INTEGER ID PK
        VARCHAR2_32 LABEL "тип: VARCHAR2(32)"
        VARCHAR2_32 VALUE "тип: VARCHAR2(32)"
    }

    SC_CATEGORY_MAP {
        INTEGER SC_CODE FK "FK из документа: ORGANIZATION.EXTERNALKEY"
        INTEGER SC_CATEGORY_ID FK "FK из документа: SC_CATEGORY.ID"
    }

    PRE_SESSION_STATE {
        INTEGER ID PK
        VARCHAR2_64 HASH_KEY "тип: VARCHAR2(64)"
        VARCHAR2_8 APP_TYPE "тип: VARCHAR2(8)"
        RAW_8 USER_ID FK "тип: RAW(8); FK из документа: BGUSER.ID"
        INTEGER LOCALE_ID FK "FK из документа: LOCALE.ID"
        VARCHAR2_4 INITIATOR_TYPE "тип: VARCHAR2(4)"
        INTEGER INITIATOR_CODE
        VARCHAR2_32 INITIATOR_TRANSACTION_ID "тип: VARCHAR2(32)"
        VARCHAR2_255 INITIATOR_REDIRECT_URL "тип: VARCHAR2(255)"
        BLOB INITIAL_VIEW_STATE
        TIMESTAMP_3 CREATE_DATE_TIME "тип: TIMESTAMP(3)"
        NUMBER_1 STATUS "тип: NUMBER(1)"
        TIMESTAMP_3 STATUS_CHANGE_DATE_TIME "тип: TIMESTAMP(3)"
    }

    LOCALE {
        INTEGER ID PK
        VARCHAR2_5 LANG "тип: VARCHAR2(5)"
    }

    PAYMENT_EXT {
        RAW_8 ID "тип: RAW(8)"
        INTEGER PAYMENT_RECEIVER
        NVARCHAR2_32 INTERNALREFNUMBER "тип: NVARCHAR2(32)"
        NUMBER_1 SERVICE_TERMINAL "тип: NUMBER(1)"
        NVARCHAR2_32_BYTE REQUEST_TRANSACTION_ID "тип: NVARCHAR2(32 Byte)"
        INTEGER PAYMENT_METHOD_ID FK "FK из документа: PAYMENT_METHOD.ID"
        NUMBER_1 SMART_METERED "тип: NUMBER(1)"
        NUMBER_10_2 SMART_AMOUNT_LOADED "тип: NUMBER(10,2)"
        VARCHAR2_32_BYTE OPERATION_TRANSACTION_ID "тип: VARCHAR2(32 Byte)"
        VARCHAR2_32_BYTE PROCESS_TRANSACTION_ID "тип: VARCHAR2(32 Byte)"
        INTEGER PROCESS_OWNER_CODE
        INTEGER SP_BRANCH_CODE
        INTEGER INITIATOR_CODE
        VARCHAR2_4_BYTE INITIATOR_TYPE "тип: VARCHAR2(4 Byte)"
    }

    PAYMENT_DATA {
        INTEGER RECEIPT_NUMBER
        RAW_8 EPMT_ID "тип: RAW(8)"
        RAW_8 HPMT_ID "тип: RAW(8)"
        INTEGER EPMT_REQUEST_DATE
        INTEGER EPMT_REQUEST_TIME
        NUMBER_28_5 EPMT_PAYABLE_AMOUNT "тип: NUMBER(28,5)"
        INTEGER EPMT_STATE_CODE
        INTEGER EPMT_TYPE
        INTEGER HPMT_TELLER_KEY
        INTEGER CSP_HEAD_BRANCH
        INTEGER CSP_TELLER_REALM
        INTEGER UC_HEAD
        INTEGER UC_BRANCH
        NVARCHAR2_32 APUSID "тип: NVARCHAR2(32)"
        NVARCHAR2_32 ACCOUNT_EXTKEY "тип: NVARCHAR2(32)"
        NVARCHAR2_32 STATEMENT_EXT_KEY "тип: NVARCHAR2(32)"
        RAW_8 STATEMENT_ID "тип: RAW(8)"
        NVARCHAR2_32 INTERNAL_REF_NUMBER "тип: NVARCHAR2(32)"
        CHAR_1_BYTE ABONTYPE "тип: CHAR(1 BYTE)"
        INTEGER STATEMENT_DATE
        NUMBER_28_5 STATEMENT_DEBT "тип: NUMBER(28,5)"
        RAW_8 AUTHORIZATIONID "тип: RAW(8)"
        DATE EPMT_DATE_TIME
        DATE EPMT_DATE
        VARCHAR2_24_BYTE TERMINALID "тип: VARCHAR2(24 BYTE)"
        DATE CANCEL_DATE
        NVARCHAR2_2000 DETAILS "тип: NVARCHAR2(2000)"
        INTEGER SERVICE_CODE
        NUMBER_5_2 SERVICE_FEE "тип: NUMBER(5,2)"
        INTEGER PMT_RECEIVER
        NVARCHAR2_32 DOC_NUMBER "тип: NVARCHAR2(32)"
        NUMBER_10_2 CURRENT_DEBT "тип: NUMBER(10,2)"
        NUMBER_1 SERVICE_TERMINAL "тип: NUMBER(1)"
        NUMBER_1 SMART_METERED "тип: NUMBER(1)"
        NUMBER_10_2 SMART_AMOUNT_LOADED "тип: NUMBER(10,2)"
        RAW_8 ACCOUNT_ID "тип: RAW(8)"
        INTEGER PAYMENT_METHOD_ID FK "FK из документа: PAYMENT_METHOD.ID"
        INTEGER PROCESS_OWNER_CODE
        VARCHAR2_32_BYTE PROCESS_TRANSACTION_ID "тип: VARCHAR2(32 BYTE)"
        INTEGER SP_CODE
        INTEGER SP_BRANCH_CODE
        NUMBER_2 PAYMENT_INSTRUMENT_CATEGORY "тип: NUMBER(2)"
    }

    IDENTIFICATION_METHOD {
        INTEGER ID
        VARCHAR2_8 SOURCE "тип: VARCHAR2(8)"
        VARCHAR2_4 TYPE "тип: VARCHAR2(4)"
        VARCHAR2_8 SUBTYPE "тип: VARCHAR2(8)"
    }

    IDEN_MTD_PREFIX {
        INTEGER ID
        VARCHAR2_64CHAR LABEL "тип: VARCHAR2(64Char)"
        NVARCHAR2_32 VALUE "тип: NVARCHAR2(32)"
    }

    SC_SUPPORTED_IDEN_MTD {
        INTEGER ID
        INTEGER SC_CODE FK "FK из документа: ORGANIZATION.EXTERNALKEY"
        INTEGER IDENTIFICATION_METHOD_ID FK "FK из документа: IDENTIFICATION_METHOD.ID"
        NUMBER_1 VIEWABLE "тип: NUMBER(1)"
        NUMBER_1 VIEW_PRIORITY "тип: NUMBER(1)"
        NUMBER_1 PREFIXED "тип: NUMBER(1)"
        NUMBER_1 STATUS "тип: NUMBER(1)"
    }

    SC_IDEN_MTD_PREFIX_MAP {
        INTEGER SC_IDEN_MTD_ID
        INTEGER SERVICE_TYPE_ID
    }

    SC_IDEN_MTD_PREFIX_MAP_VARIANT_2 {
        INTEGER CODE
        NVARCHAR2_100 DESCRIPTION "тип: NVARCHAR2(100)"
        INTEGER ORGANIZATION_EXT_KEY
    }

    SERVICE_TYPES {
        INTEGER ORGANIZATION_EXT_KEY
        INTEGER SERVICE_CODE
        NVARCHAR2_300 SERVICE_NAME "тип: NVARCHAR2(300)"
        CHAR_1_BYTE PRE_PAYMENT "тип: CHAR(1 Byte)"
        CHAR_1_BYTE PARTIAL_PAYMENT "тип: CHAR(1 Byte)"
        INTEGER INVOICE_EXPIRE_METHOD
        NVARCHAR2_2 BUDGET_LEVEL_CODE "тип: NVARCHAR2(2)"
        INTEGER STATUS
        INTEGER SERVICE_GROUP_CODE
        INTEGER PAYMENT_RECEIVER
        INTEGER SERVICE_FEE
        CHAR_1_BYTE SHOW_INVOICE_INFO "тип: CHAR(1 Byte)"
        INTEGER DISCOUNT_PENALTY
        INTEGER DISCOUNT_DAYS
        INTEGER DISCOUNT_FORMULA
        INTEGER PENALTY_START_DAYS
        INTEGER PENALTY_FORMULA
        INTEGER PENALTY_MAX_DAYS
        INTEGER CODE_26T
        NUMBER_5_2 SERVICE_FEE_PERCENT "тип: NUMBER(5,2)"
        NUMBER_5_2 SERVICE_FEE_MIN_AMOUNT "тип: NUMBER(5,2)"
        NUMBER_5_2 SERVICE_FEE_MAX_AMOUNT "тип: NUMBER(5,2)"
        INTEGER BUDGET_CODE
        CHAR_1_BYTE PAYMENT_CANCEL_ALLOWED "тип: CHAR(1 Byte)"
        NUMBER_1 ASAN "тип: NUMBER(1)"
        INTEGER ID
        NVARCHAR2_2 SP_BUDGET_LEVEL_CODE "исходное имя: SP_ BUDGET_LEVEL_CODE; тип: NVARCHAR2(2)"
    }

    OPERATION {
        NUMBER_20 ID "тип: NUMBER(20)"
        NUMBER_20 MESSAGE_ID "тип: NUMBER(20)"
        NUMBER_20 REQUIRED_OPERATION_ID "тип: NUMBER(20)"
        VARCHAR2_50_BYTE METHOD_NAME "тип: VARCHAR2(50 Byte)"
        BLOB OPERATION_DATA
        CHAR_1_BYTE STATUS "тип: CHAR(1 Byte)"
        TIMESTAMP_6 STATUS_CHANGE_DATE "тип: TIMESTAMP(6)"
        DATE REQUEST_DATE
        TIMESTAMP_6 CREATE_DATE "тип: TIMESTAMP(6)"
        VARCHAR2_32_BYTE TYPE "тип: VARCHAR2(32 Byte)"
    }

    OPERATION_SEARCH {
        VARCHAR2_50_BYTE FIELD_NAME "тип: VARCHAR2(50 Byte)"
        VARCHAR2_255_BYTE FIELD_VALUE "тип: VARCHAR2(255 Byte)"
        NUMBER_20 OPERATION_ID FK "тип: NUMBER(20); FK из документа: OPERATION.ID"
    }

    MESSAGE {
        NUMBER_20 ID "тип: NUMBER(20)"
        VARCHAR2_32_BYTE APP_CODE "тип: VARCHAR2(32 Byte)"
        VARCHAR2_128_BYTE TYPE "тип: VARCHAR2(128 Byte)"
        NUMBER_1 OUTBOUND "тип: NUMBER(1)"
        VARCHAR2_32_BYTE TRANSACTION_ID "тип: VARCHAR2(32 Byte)"
        NUMBER_6 SENDER_CODE "тип: NUMBER(6)"
        NUMBER_6 RECEIVER_CODE "тип: NUMBER(6)"
        VARCHAR2_2048_BYTE URL "тип: VARCHAR2(2048 Byte)"
        CHAR_1_BYTE STATUS "тип: CHAR(1 Byte)"
        DATE MESSAGE_DATE
        TIMESTAMP_6 CREATE_DATE "тип: TIMESTAMP(6)"
    }

    MESSAGE_STORAGE {
        NUMBER_20 ID "тип: NUMBER(20)"
        BLOB MESSAGE
        TIMESTAMP_6 CREATE_DATE "тип: TIMESTAMP(6)"
    }

    EXTERNAL_HOST_MAP {
        VARCHAR2_255_BYTE EXTERNAL_HOST "тип: VARCHAR2(255 Byte)"
        VARCHAR2_255_BYTE PROXY_URL "тип: VARCHAR2(255 Byte)"
    }

    STATEMENT_EXT {
        RAW_8 ID "тип: RAW(8)"
        NUMBER_10_2 CURRENT_DEBT "тип: NUMBER(10,2)"
        NVARCHAR2_32 DOC_NUMBER "тип: NVARCHAR2(32)"
        INTEGER PAYMENT_RECEIVER_CODE
        INTEGER SC_CODE
        INTEGER SC_IDEN_MTD_ID FK "FK из документа: SC_SUPPORTED_ IDEN_MTD.ID"
        NVARCHAR2_32 INVOICE_CODE "тип: NVARCHAR2(32)"
    }

    PMT_BUFFER_CPC {
        UNKNOWN WEB_SID
        UNKNOWN REQUEST_TIME
        UNKNOWN AMOUNT
        UNKNOWN STATUS
        UNKNOWN STATUS_DATE_TIME
        UNKNOWN STATUS_CHANGE_NUMBER
        UNKNOWN DETAILS
        UNKNOWN CPC_TRANSACTION_NUMBER
        UNKNOWN CPC_CODE
    }

    PMTSIGNATURES {
        RAW_8 ID "тип: RAW(8)"
        DATE CREATE_DATE
        BLOB MESSAGETEXT
        RAW_8 ID_FROM_PMTAUTORIZATION "тип: RAW(8)"
    }

    REGIONS {
        NVARCHAR2_32 REGION_NAME "тип: NVARCHAR2(32)"
        NUMBER_3 IAMAS_CITY "тип: NUMBER(3)"
        NUMBER_3 IAMAS_DISTRICT "тип: NUMBER(3)"
        NUMBER_3 IAMAS_LOCATION "тип: NUMBER(3)"
        NVARCHAR2_3 DSK_CODE "тип: NVARCHAR2(3)"
    }

    PHONE_AREA {
        INTEGER ID
        NUMBER_5 AREA_CODE "тип: NUMBER(5)"
        VARCHAR2_30_BYTE AREA_NAME "тип: VARCHAR2(30 Byte)"
    }

    SC_SERVICE_FEE {
        NVARCHAR2_32 UC_HEAD "тип: NVARCHAR2(32)"
        NVARCHAR2_32 BANK_HEAD "тип: NVARCHAR2(32)"
        NUMBER_5_2 JURIDICAL_FEE_PERCENT "тип: NUMBER(5,2)"
        NUMBER_5_2 PHYSICAL_FEE_PERCENT "тип: NUMBER(5,2)"
    }

    AMG_MSG {
        VARCHAR2_70_BYTE SERIAL_NUMBER "тип: VARCHAR2(70 BYTE)"
        DATE MSG_DATE
        VARCHAR2_30_BYTE MSG_TYPE "тип: VARCHAR2(30 BYTE)"
        BLOB MSG_TEXT
        VARCHAR2_100_BYTE MSG_RESULT "тип: VARCHAR2(100 BYTE)"
        INTEGER STATE
        DATE STATE_CHANGE_DATE
        DATE MSG_DATE_TIME
    }

    PAYMENT_NOTIFICATION {
        RAW_8 PAYMENT_ID "тип: RAW(8)"
        INTEGER PMT_NTFY_TYPE_ID
        VARCHAR2_70_BYTE BATCH_SERIAL "тип: VARCHAR2(70 Byte)"
        VARCHAR2_128_BYTE DESCRIPTION "тип: VARCHAR2(128 Byte)"
        TIMESTAMP_3 EVENT_DATE_TIME "тип: TIMESTAMP(3)"
        TIMESTAMP_3 CREATE_DATE_TIME "тип: TIMESTAMP(3)"
    }

    PAYMENT_NOTIFICATION_TYPES {
        INTEGER ID PK
        VARCHAR2_8_BYTE NOTIFICATION_METHOD "тип: VARCHAR2(8 Byte)"
        VARCHAR2_32_BYTE SHORT_NAME "тип: VARCHAR2(32 Byte)"
        VARCHAR2_128_BYTE DESCRIPTION "тип: VARCHAR2(128 Byte)"
    }

    SC_CATEGORY ||--o{ SC_CATEGORY_MAP : "SC_CATEGORY_ID -> ID"
    LOCALE ||--o{ PRE_SESSION_STATE : "LOCALE_ID -> ID"
    IDENTIFICATION_METHOD ||--o{ SC_SUPPORTED_IDEN_MTD : "IDENTIFICATION_METHOD_ID -> ID"
    OPERATION ||--o{ OPERATION_SEARCH : "OPERATION_ID -> ID"
    SC_SUPPORTED_IDEN_MTD ||--o{ STATEMENT_EXT : "SC_IDEN_MTD_ID -> ID"
    MESSAGE ||--o{ OPERATION : "логическая ссылка MESSAGE_ID -> ID"
    OPERATION ||--o{ OPERATION : "логическая ссылка REQUIRED_OPERATION_ID -> ID"
    MESSAGE ||--o| MESSAGE_STORAGE : "логическая ссылка ID -> ID"
    PAYMENT_NOTIFICATION_TYPES ||--o{ PAYMENT_NOTIFICATION : "логическая ссылка PMT_NTFY_TYPE_ID -> ID"

    %% INFERENCE logical FK - не физические Oracle constraints. Полный registry: logical-foreign-keys.yaml
    SC_SUPPORTED_IDEN_MTD ||..o{ SC_IDEN_MTD_PREFIX_MAP : "INFERENCE SC_IDEN_MTD_ID -> ID"
    SC_IDEN_MTD_PREFIX_MAP_VARIANT_2 ||..o{ SERVICE_TYPES : "INFERENCE SERVICE_GROUP_CODE -> CODE"
    SERVICE_TYPES ||..o{ PAYMENT_DATA : "INFERENCE UC_HEAD+SERVICE_CODE -> ORG+SERVICE_CODE"
    PMTSIGNATURES ||..o{ PAYMENT_DATA : "INFERENCE AUTHORIZATIONID -> ID"
    PAYMENT_DATA ||..o{ PAYMENT_NOTIFICATION : "INFERENCE PAYMENT_ID -> EPMT_ID"
    AMG_MSG ||..o{ PAYMENT_NOTIFICATION : "INFERENCE batch BATCH_SERIAL -> SERIAL_NUMBER"
    PAYMENT_DATA ||..o| PAYMENT_EXT : "INFERENCE ID -> EPMT_ID (tentative)"

